# CyberGIS Phase 2 — local environment template. Copy to .env (never commit .env):
#   sh infra/scripts/init-env.sh      # copies this file and replaces every CHANGE_ME with a random value
#   cp .env.example .env              # or copy by hand, then replace every CHANGE_ME yourself
# Docker Compose reads .env from the project directory automatically.

COMPOSE_PROJECT_NAME=cgis

# --- PostgreSQL/PostGIS owner (used by db and the migrate one-shot only)
# The owner name must not equal a project schema (cgis, catalog, geo, ops, cgis_meta, raster_demo):
# PostgreSQL's default search_path "$user", public would then create unqualified objects, such as
# the postgis_raster extension, in that schema.
POSTGRES_DB=cgis
POSTGRES_USER=cgis_admin
POSTGRES_PASSWORD=CHANGE_ME

# --- Per-service login roles, created by the migrate service (infra/db/provision_roles.py)
# Use letters, digits and underscores in user names; keep passwords URL-safe (the generator uses hex).
INGEST_DB_USER=cgis_ingestion_svc
INGEST_DB_PASSWORD=CHANGE_ME
OGC_DB_USER=cgis_ogc_svc
OGC_DB_PASSWORD=CHANGE_ME
PROCESSING_DB_USER=cgis_processing_svc
PROCESSING_DB_PASSWORD=CHANGE_ME

# --- Gateway (the only published port). Keep 127.0.0.1 unless you need LAN access.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8080
# Public base URL used in OGC API links; must match how clients reach the gateway.
PUBLIC_BASE_URL=http://localhost:8080

# --- Optional tuning (defaults shown)
OGC_REFRESH_INTERVAL=30
OGC_WORKERS=2
TILES_WORKERS=2
CGIS_CATALOG_CACHE_TTL=30
PROCESSING_MAX_CONCURRENT_JOBS=4
PROCESSING_OUTPUT_TTL_SECONDS=86400

# --- Optional development DB port, used only with infra/compose.db-port.yaml
DB_HOST_PORT=55432
