# CyberGIS local environment template. Never commit .env.
#   sh infra/scripts/init-env.sh   # creates .env with random values for every CHANGE_ME (or appends new keys)

COMPOSE_PROJECT_NAME=cgis

# --- Compose profiles started by `docker compose up` (comma-separated):
#   app      application API (accounts, admin uploads/publication, exports)   [default]
#   (empty)  platform only: OGC API, tiles, processing, viewer
COMPOSE_PROFILES=app

# --- PostgreSQL/PostGIS owner (used by db and the migrate one-shots only)
# The owner name must not equal a project schema (cgis, catalog, geo, ops, cgis_meta, raster_demo, cgis_app):
# PostgreSQL's default search_path "$user", public would then create unqualified objects, such as
# the postgis_raster extension, in that schema.
POSTGRES_DB=cgis
POSTGRES_USER=cgis_admin
POSTGRES_PASSWORD=CHANGE_ME

# --- Per-service login roles, created by the migrate service (database/cgis_db/setup.py)
# Use letters, digits and underscores in user names; keep passwords URL-safe (the generator uses hex).
INGEST_DB_USER=cgis_ingestion_svc
INGEST_DB_PASSWORD=CHANGE_ME
OGC_DB_USER=cgis_ogc_svc
OGC_DB_PASSWORD=CHANGE_ME
PROCESSING_DB_USER=cgis_processing_svc
PROCESSING_DB_PASSWORD=CHANGE_ME

# --- Application API (profile "app"; every APP_* option is listed in README.md)
# Login roles created by `cgis-app migrate`; bootstrap accounts created once if absent. No default passwords.
APP_DB_USER=cgis_app_svc
APP_DB_PASSWORD=CHANGE_ME
APP_WORKER_DB_USER=cgis_app_worker_svc
APP_WORKER_DB_PASSWORD=CHANGE_ME
APP_BOOTSTRAP_ADMIN_USERNAME=cgis-admin
APP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
APP_BOOTSTRAP_USER_USERNAME=cgis-viewer
APP_BOOTSTRAP_USER_PASSWORD=CHANGE_ME
# Access policy for datasets without an explicit policy: users | public | admins
APP_DEFAULT_DATASET_ACCESS=users

# --- Gateway (the only published port). Keep 127.0.0.1 unless you need LAN access.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8080
# Public base URL used in OGC API links; must match how clients reach the gateway.
PUBLIC_BASE_URL=http://localhost:8080
# Read routes /ogc/, /tiles/, /api/operations, /api/downloads:
#   public     anonymous (local demo, OGC CITE runs)                                    [default]
#   protected  signed-in user or personal access token required (needs profile "app");
#              use it whenever restricted datasets are published. Admin writes are always protected.
GATEWAY_READ_ACCESS=public

# --- Optional tuning (defaults shown)
OGC_REFRESH_INTERVAL=30
OGC_WORKERS=2
TILES_WORKERS=2
CGIS_CATALOG_CACHE_TTL=30
PROCESSING_MAX_CONCURRENT_JOBS=4
PROCESSING_OUTPUT_TTL_SECONDS=86400
# Background (async) processing of large AOIs: worker threads, block edge (pixels), limits
PROCESSING_ASYNC_WORKERS=1
PROCESSING_BLOCK_SIZE=2048
PROCESSING_ASYNC_MAX_WINDOW_PIXELS=2000000000
PROCESSING_ASYNC_MAX_OUTPUT_BYTES=2147483648
PROCESSING_ASYNC_MAX_JOB_SECONDS=3600

# --- Memory limits for a 16 GB machine (Docker mem_limit syntax; budget table in README.md)
DB_MEM_LIMIT=2g
TILES_MEM_LIMIT=1536m
OGC_MEM_LIMIT=1g
PROCESSING_MEM_LIMIT=2g
INGESTION_MEM_LIMIT=4g

# --- Optional development DB port, used only with infra/compose.db-port.yaml
DB_HOST_PORT=55432
