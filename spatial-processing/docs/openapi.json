  "components": {
    "schemas": {
      "ClipRequest": {
        "properties": {
          "dataset_id": {
            "type": "string",
            "maxLength": 128,
            "title": "Dataset Id",
            "description": "Catalog dataset ID (not a path or URL)."
          },
          "aoi": {
            "additionalProperties": true,
            "type": "object",
            "title": "Aoi",
            "description": "GeoJSON Polygon or MultiPolygon (or a Feature wrapping one), x/y (lon/lat) order."
          },
          "aoi_crs": {
            "type": "string",
            "maxLength": 64,
            "title": "Aoi Crs",
            "description": "CRS of `aoi` as 'EPSG:<code>' (e.g. 'EPSG:4326')."
          },
          "output_crs": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Crs",
            "description": "Output CRS 'EPSG:<code>'. Omit (or use the native CRS) for an exact native-grid clip; a different CRS triggers nearest-neighbour reprojection (totals not preserved)."
          },
          "format": {
            "type": "string",
            "maxLength": 16,
            "title": "Format",
            "description": "'GTiff' or 'COG'.",
            "default": "GTiff"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset_id",
          "aoi",
          "aoi_crs"
        ],
        "title": "ClipRequest",
        "example": {
          "aoi": {
            "coordinates": [
              [
                [
                  78.01,
                  17.98
                ],
                [
                  78.02,
                  17.98
                ],
                [
                  78.02,
                  17.99
                ],
                [
                  78.01,
                  17.99
                ],
                [
                  78.01,
                  17.98
                ]
              ]
            ],
            "type": "Polygon"
          },
          "aoi_crs": "EPSG:4326",
          "dataset_id": "synthetic-worldpop-2001",
          "format": "GTiff",
          "output_crs": "EPSG:4326"
        }
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "JobLinks": {
        "properties": {
          "self": {
            "type": "string",
            "title": "Self"
          },
          "download": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Download"
          },
          "metadata": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "self"
        ],
        "title": "JobLinks"
      },
      "JobResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "clip",
              "zonal-statistics"
            ],
            "title": "Kind"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "input": {
            "additionalProperties": true,
            "type": "object",
            "title": "Input"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorBody"
              },
              {
                "type": "null"
              }
            ]
          },
          "links": {
            "$ref": "#/components/schemas/JobLinks"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "kind",
          "status",
          "created_at",
          "updated_at",
          "input",
          "links"
        ],
        "title": "JobResponse"
      },
      "PixelSelection": {
        "properties": {
          "rule": {
            "type": "string",
            "const": "pixel_center",
            "title": "Rule"
          },
          "all_touched": {
            "type": "boolean",
            "title": "All Touched"
          },
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "rule",
          "all_touched",
          "description"
        ],
        "title": "PixelSelection"
      },
      "ZonalStatisticsRequest": {
        "properties": {
          "dataset_id": {
            "type": "string",
            "maxLength": 128,
            "title": "Dataset Id",
            "description": "Catalog dataset ID (not a path or URL)."
          },
          "aoi": {
            "additionalProperties": true,
            "type": "object",
            "title": "Aoi",
            "description": "GeoJSON Polygon or MultiPolygon (or a Feature wrapping one), x/y (lon/lat) order."
          },
          "aoi_crs": {
            "type": "string",
            "maxLength": 64,
            "title": "Aoi Crs",
            "description": "CRS of `aoi` as 'EPSG:<code>' (e.g. 'EPSG:4326')."
          },
          "operations": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "maxItems": 8
              },
              {
                "type": "null"
              }
            ],
            "title": "Operations",
            "description": "Subset of 'sum', 'mean', 'count'. Default: all."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset_id",
          "aoi",
          "aoi_crs"
        ],
        "title": "ZonalStatisticsRequest",
        "example": {
          "aoi": {
            "coordinates": [
              [
                [
                  78.01,
                  17.98
                ],
                [
                  78.02,
                  17.98
                ],
                [
                  78.02,
                  17.99
                ],
                [
                  78.01,
                  17.99
                ],
                [
                  78.01,
                  17.98
                ]
              ]
            ],
            "type": "Polygon"
          },
          "aoi_crs": "EPSG:4326",
          "dataset_id": "synthetic-worldpop-2001",
          "operations": [
            "sum",
            "mean",
            "count"
          ]
        }
      },
      "ZonalStatisticsResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id"
          },
          "dataset_version": {
            "type": "integer",
            "title": "Dataset Version"
          },
          "count_valid": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Count Valid",
            "description": "Number of non-NoData pixels whose centers fall in the AOI."
          },
          "sum": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sum",
            "description": "Sum of valid pixel values; see `sum_semantics`."
          },
          "mean": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean"
          },
          "units": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Units"
          },
          "sum_semantics": {
            "type": "string",
            "enum": [
              "total_count",
              "not_applicable_density",
              "sum_of_cell_values"
            ],
            "title": "Sum Semantics"
          },
          "pixels_in_aoi": {
            "type": "integer",
            "title": "Pixels In Aoi"
          },
          "nodata_excluded": {
            "type": "integer",
            "title": "Nodata Excluded",
            "description": "Pixels in the AOI that were NoData/masked and excluded."
          },
          "nodata_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nodata Value"
          },
