{
  "name": "exports_capabilities",
  "request": {
    "method": "GET",
    "path": "/api/exports/capabilities",
    "body": null
  },
  "note": null,
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "kinds": [
        "full",
        "clip"
      ],
      "formats": {
        "raster": [
          {
            "id": "GTiff",
            "label": "GeoTIFF (tiled, DEFLATE, lossless)",
            "media_type": "image/tiff; application=geotiff",
            "extension": "tif"
          },
          {
            "id": "COG",
            "label": "Cloud-Optimized GeoTIFF",
            "extension": "tif",
            "media_type": "image/tiff; application=geotiff; profile=cloud-optimized"
          }
        ],
        "vector": [
          {
            "id": "GeoJSON",
            "label": "GeoJSON (RFC 7946 in EPSG:4326)",
            "media_type": "application/geo+json",
            "extension": "geojson"
          }
        ]
      },
      "output_crs": {
        "suggested": [
          {
            "id": "EPSG:4326",
            "label": "WGS 84 (longitude/latitude)"
          },
          {
            "id": "EPSG:3857",
            "label": "WGS 84 / Pseudo-Mercator (web maps; not equal-area)"
          },
          {
            "id": "EPSG:24378",
            "label": "Kalianpur 1975 / India zone I"
          },
          {
            "id": "EPSG:32643",
            "label": "WGS 84 / UTM zone 43N"
          },
          {
            "id": "EPSG:32644",
            "label": "WGS 84 / UTM zone 44N"
          },
          {
            "id": "EPSG:32645",
            "label": "WGS 84 / UTM zone 45N"
          },
          {
            "id": "EPSG:6933",
            "label": "WGS 84 / NSIDC EASE-Grid 2.0 Global (equal-area)"
          }
        ],
        "accepts_any_epsg": true,
        "native_default": true,
        "rules": "EPSG:<code> naming a 2D geographic or projected CRS. Omit for the native CRS (exact)."
      },
      "aoi": {
        "crs_default": "EPSG:4326",
        "geometry_types": [
          "Polygon",
          "MultiPolygon",
          "Feature"
        ],
        "pixel_selection": "raster clip keeps pixels whose CENTER lies in the AOI (all_touched=false)",
        "vector_clip": "features intersecting the AOI, geometries cut to the AOI"
      },
      "resampling": "nearest (only when output_crs differs from the native CRS)",
      "notes": [
        "Reprojected with nearest-neighbour resampling onto a new grid: cell values are copied, not area-weighted, so totals of count rasters (e.g. people_per_cell) are NOT preserved. Export in the native CRS for analysis.",
        "GeoJSON in a CRS other than EPSG:4326 is not RFC 7946 compliant; a legacy 'crs' member names the CRS (read by GDAL/QGIS). Use EPSG:4326 for maximum interoperability."
