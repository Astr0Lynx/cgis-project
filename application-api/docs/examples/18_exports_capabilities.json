      "limits": {
        "clip_max_pixels": 2000000,
        "max_output_bytes": 8589934592,
        "max_pixels": 50000000,
        "max_seconds": 3600,
        "retention_seconds": 86400,
        "max_active_jobs_per_user": 4,
        "max_aoi_vertices": 10000,
        "max_aoi_parts": 100
      },
      "authentication": "required for POST /api/exports and downloads (cookie session, bearer or token)"
    }
  }
