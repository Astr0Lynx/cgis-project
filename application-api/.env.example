# CyberGIS application API (Agent 5) - placeholders to ADD to the root .env (never commit .env).
#   sh infra/scripts/init-env.sh             # root .env from the root .env.example (Agent 4)
#   sh application-api/scripts/init-env.sh   # appends the block below with random secrets; never overwrites
# Every CHANGE_ME is replaced with a random value by the script. There are NO default passwords.

# --- Database login roles created by `cgis-app migrate` (members of cgis_app_api / cgis_app_worker)
APP_DB_USER=cgis_app_svc
APP_DB_PASSWORD=CHANGE_ME
APP_WORKER_DB_USER=cgis_app_worker_svc
APP_WORKER_DB_PASSWORD=CHANGE_ME

# --- Bootstrap accounts, created once by `cgis-app bootstrap` if absent (leave the user pair empty to skip).
# Passwords: >= 12 characters, not containing the username. Rotate with `cgis-app users passwd <name>`.
APP_BOOTSTRAP_ADMIN_USERNAME=cgis-admin
APP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
APP_BOOTSTRAP_USER_USERNAME=cgis-viewer
APP_BOOTSTRAP_USER_PASSWORD=CHANGE_ME
# true: re-apply the bootstrap passwords above on every start (revokes that account's sessions)
APP_BOOTSTRAP_RESET_PASSWORDS=false

# --- Access policy for datasets without an explicit policy: users (default) | public | admins
#   public = anonymous discovery (demo only); exports always require a signed-in user.
APP_DEFAULT_DATASET_ACCESS=users

# --- Sessions (seconds). Secure cookies are enabled automatically when PUBLIC_BASE_URL is https://
APP_SESSION_TTL_SECONDS=28800
APP_SESSION_IDLE_SECONDS=3600
APP_COOKIE_SECURE=false
APP_HTTP_WORKERS=2

# --- Limits (bytes) sized for the 16 GB local target
APP_MAX_UPLOAD_BYTES=8589934592
APP_MAX_VECTOR_UPLOAD_BYTES=268435456
APP_STAGING_MAX_TOTAL_BYTES=34359738368
APP_EXPORT_MAX_OUTPUT_BYTES=8589934592
APP_EXPORT_MAX_TOTAL_BYTES=34359738368
APP_EXPORT_TTL_SECONDS=86400
APP_EXPORT_MAX_SECONDS=3600
APP_MIN_FREE_BYTES=2147483648
APP_GDAL_CACHEMAX_MB=256
APP_LOG_LEVEL=INFO
