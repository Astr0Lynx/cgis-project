# Files are copied into Linux containers, so keep LF line endings on every checkout,
# including Windows clones with core.autocrlf=true (CRLF breaks shell entrypoints).
* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.tif  binary
*.tiff binary
*.png  binary
*.jpg  binary
*.gz   binary
*.zip  binary
*.pdf  binary
*.gpkg binary
